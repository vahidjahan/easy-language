# Microsoft Entra External ID external tenant
VITE_ENTRA_CLIENT_ID=<spa-application-client-id>
VITE_ENTRA_AUTHORITY=https://<tenant-subdomain>.ciamlogin.com/
VITE_ENTRA_API_SCOPE=api://<api-application-client-id>/access_as_user

# Optional when the deployed Function App uses a separate hostname.
# Local Vite development uses https://localhost:5173 and proxies /api to the Functions host.
VITE_API_BASE_URL=
